<urn:telco:graph:tbox:sid-etom> {
    telco:accountManagerCode a owl:DatatypeProperty ;
        rdfs:label "account manager code"@en ;
        rdfs:comment "Unique employee or desk identifier of the designated enterprise account manager."@en ;
        rdfs:domain tmf:Customer ;
        rdfs:range xsd:string ;
        skos:altLabel "account executive ID"@en,
            "assigned sales representative"@en .

    telco:affectedCircuit a owl:ObjectProperty ;
        rdfs:label "affected circuit"@en ;
        rdfs:comment "References the Customer Facing Service circuit impacted by an assurance incident."@en ;
        rdfs:domain tmf:TroubleTicket ;
        rdfs:range tmf:CustomerFacingService ;
        skos:altLabel "impacted CFS circuit"@en,
            "trouble ticket circuit"@en .

    telco:affectedResource a owl:ObjectProperty ;
        rdfs:label "affected resource"@en ;
        rdfs:comment "References the physical network resource identified as the root cause of an assurance fault."@en ;
        rdfs:domain tmf:TroubleTicket ;
        rdfs:range tmf:PhysicalResource ;
        skos:altLabel "faulty hardware resource"@en,
            "root cause asset"@en .

    telco:autoRemediationAllowed a owl:DatatypeProperty ;
        rdfs:label "auto-remediation allowed"@en ;
        rdfs:comment "Indicates whether autonomous optical recalibration is legally and technically permitted."@en ;
        rdfs:domain tmf:ServiceSpecification ;
        rdfs:range xsd:boolean ;
        skos:altLabel "automated triage allowed"@en,
            "self-healing authorization flag"@en .

    telco:availabilityTargetPct a owl:DatatypeProperty ;
        rdfs:label "availability target percentage"@en ;
        qudt:applicableUnit unit:PERCENT ;
        rdfs:comment "Annual uptime percentage guaranteed under the commercial service tier."@en ;
        rdfs:domain tmf:ServiceSpecification ;
        rdfs:range xsd:double ;
        skos:altLabel "SLA availability target"@en,
            "uptime commitment percentage"@en .

    telco:bandwidthGbps a owl:DatatypeProperty ;
        rdfs:label "bandwidth in gigabits per second"@en ;
        qudt:applicableUnit unit:GigaBIT-PER-SEC ;
        rdfs:comment "Contracted symmetrical bandwidth normalized to Gigabits per second."@en ;
        rdfs:domain tmf:CustomerFacingService ;
        rdfs:range xsd:double ;
        skos:altLabel "circuit throughput Gbps"@en,
            "normalized capacity"@en .

    telco:chamberOfCommerceReg a owl:DatatypeProperty ;
        rdfs:label "chamber of commerce registration"@en ;
        rdfs:comment "Official commercial trade registry or chamber of commerce number for the enterprise."@en ;
        rdfs:domain tmf:Customer ;
        rdfs:range xsd:string ;
        skos:altLabel "KvK registration"@en,
            "trade registry number"@en .

    telco:demarcatesAtCpe a owl:ObjectProperty ;
        rdfs:label "demarcates at CPE"@en ;
        rdfs:comment "Identifies the Customer Premises Equipment device serving as the on-site network demarcation endpoint."@en ;
        rdfs:domain tmf:ResourceFacingService ;
        rdfs:range telco:CpeDeviceResource ;
        skos:altLabel "customer demarcation chassis"@en,
            "on-premises CPE asset"@en .

    telco:fiberSpanId a owl:DatatypeProperty ;
        rdfs:label "fiber span identifier"@en ;
        rdfs:comment "Outside plant optical fiber segment identifier connecting the OLT to the customer premises."@en ;
        rdfs:domain tmf:ResourceFacingService ;
        rdfs:range xsd:string ;
        skos:altLabel "fiber span reference"@en,
            "optical cable route ID"@en .

    telco:hasOpticalCalibrationProfile a owl:ObjectProperty ;
        rdfs:label "has optical calibration profile"@en ;
        rdfs:comment "Associates an equipment model specification with its vendor DDM optical power thresholds and recalibration limits."@en ;
        rdfs:domain tmf:PhysicalResourceSpec ;
        rdfs:range telco:OpticalCalibrationProfile ;
        skos:altLabel "DDM calibration profile"@en,
            "optical power envelope"@en .

    telco:hasSlaClause a owl:ObjectProperty ;
        rdfs:label "has SLA clause"@en ;
        rdfs:comment "Associates a commercial service specification tier with contractually binding SLA guarantees and penalty clauses."@en ;
        rdfs:domain tmf:ServiceSpecification ;
        rdfs:range telco:SlaClause ;
        skos:altLabel "contractual clause"@en,
            "service SLA guarantee"@en .

    telco:installationDate a owl:DatatypeProperty ;
        rdfs:label "installation date"@en ;
        rdfs:comment "Calendar date when the customer connectivity circuit was physically handed over and activated."@en ;
        rdfs:domain tmf:CustomerFacingService ;
        rdfs:range xsd:date ;
        skos:altLabel "handover date"@en,
            "service activation date"@en .

    telco:lifecycleStatus a owl:DatatypeProperty ;
        rdfs:label "lifecycle status"@en ;
        rdfs:comment "Catalog publication state of the service specification such as ACTIVE or DEPRECATED."@en ;
        rdfs:domain tmf:ServiceSpecification ;
        rdfs:range xsd:string ;
        skos:altLabel "catalog tier status"@en,
            "specification lifecycle state"@en .

    telco:maxPacketLossPct a owl:DatatypeProperty ;
        rdfs:label "maximum packet loss percentage"@en ;
        qudt:applicableUnit unit:PERCENT ;
        rdfs:comment "Contractual frame loss ratio ceiling allowed before SLA violation occurs."@en ;
        rdfs:domain tmf:ServiceSpecification ;
        rdfs:range xsd:double ;
        skos:altLabel "frame loss ceiling"@en,
            "packet loss threshold"@en .

    telco:portIdentifier a owl:DatatypeProperty ;
        rdfs:label "port identifier"@en ;
        rdfs:comment "Physical port name or slot designation on an optical network device."@en ;
        rdfs:domain telco:OltPortResource ;
        rdfs:range xsd:string ;
        skos:altLabel "chassis port index"@en,
            "optical interface name"@en .

    telco:recommendedUpgradeSpec a owl:ObjectProperty ;
        rdfs:label "recommended upgrade specification"@en ;
        rdfs:comment "Points to the next tier commercial service specification recommended when bandwidth or packet loss thresholds are exceeded."@en ;
        rdfs:domain tmf:ServiceSpecification ;
        rdfs:range tmf:ServiceSpecification ;
        skos:altLabel "higher tier SKU"@en,
            "upgrade catalog path"@en .

    telco:rxLosCutThresholdDbm a owl:DatatypeProperty ;
        rdfs:label "loss of signal threshold in dBm"@en ;
        qudt:applicableUnit unit:MilliWATT-DeciBEL ;
        rdfs:comment "Optical power level in dBm indicating a physical fiber break and complete loss of signal."@en ;
        rdfs:domain telco:OpticalCalibrationProfile ;
        rdfs:range xsd:double ;
        skos:altLabel "LOS cut threshold"@en,
            "hard fiber break power level"@en .

    telco:rxOpticalPowerMinDbm a owl:DatatypeProperty ;
        rdfs:label "minimum Rx optical power in dBm"@en ;
        qudt:applicableUnit unit:MilliWATT-DeciBEL ;
        rdfs:comment "Minimum acceptable optical receive power level in dBm before soft attenuation alerts trigger."@en ;
        rdfs:domain telco:OpticalCalibrationProfile ;
        rdfs:range xsd:double ;
        skos:altLabel "low optical Rx boundary"@en,
            "minimum receive sensitivity"@en .

    telco:terminatesOnRouter a owl:ObjectProperty ;
        rdfs:label "terminates on router"@en ;
        rdfs:comment "Identifies the Provider Edge aggregation router hosting the L2 circuit endpoint."@en ;
        rdfs:domain tmf:ResourceFacingService ;
        rdfs:range telco:PeRouterResource ;
        skos:altLabel "aggregating PE router"@en,
            "edge router host"@en .

    telco:usesOltPort a owl:ObjectProperty ;
        rdfs:label "uses OLT port"@en ;
        rdfs:comment "Identifies the physical Optical Line Terminal transceiver port providing access connectivity for the resource service."@en ;
        rdfs:domain tmf:ResourceFacingService ;
        rdfs:range telco:OltPortResource ;
        skos:altLabel "optical line interface"@en,
            "terminates on OLT port"@en .

    telco:vlanTag a owl:DatatypeProperty ;
        rdfs:label "VLAN tag"@en ;
        rdfs:comment "IEEE 802.1Q Ethernet encapsulation identifier assigned to the Layer 2 bearer."@en ;
        rdfs:domain tmf:ResourceFacingService ;
        rdfs:range xsd:integer ;
        skos:altLabel "dot1q VLAN ID"@en,
            "outer VLAN tag"@en .

    tmf:Product a owl:Class ;
        rdfs:label "Product"@en ;
        telco:alignedEtomProcess etom:Process_1_3_7_ProblemHandling ;
        rdfs:comment "A procured commercial telecom offering binding a customer agreement to one or more CustomerFacingServices."@en ;
        skos:altLabel "Commercial Product Instance"@en,
            "Enterprise Connectivity Subscription"@en,
            "Subscribed Telecom Offering"@en .

    tmf:customerId a owl:DatatypeProperty ;
        rdfs:label "customer identifier"@en ;
        rdfs:comment "Canonical business identifier for an enterprise customer account."@en ;
        rdfs:domain tmf:Customer ;
        rdfs:range xsd:string ;
        skos:altLabel "customer account reference"@en,
            "external customer ID"@en .

    tmf:hasCustomer a owl:ObjectProperty ;
        rdfs:label "has customer"@en ;
        rdfs:comment "Associates an active Customer Facing Service with the contracted enterprise subscriber."@en ;
        rdfs:domain tmf:CustomerFacingService ;
        rdfs:range tmf:Customer ;
        skos:altLabel "service owner"@en,
            "subscriber relationship"@en .

    tmf:hasResourceSpecification a owl:ObjectProperty ;
        rdfs:label "has resource specification"@en ;
        rdfs:comment "Links a physical hardware asset to its vendor model hardware specification."@en ;
        rdfs:domain tmf:PhysicalResource ;
        rdfs:range tmf:PhysicalResourceSpec ;
        skos:altLabel "equipment model specification"@en,
            "hardware spec"@en .

    tmf:isDescribedBy a owl:ObjectProperty ;
        rdfs:label "is described by"@en ;
        rdfs:comment "Associates a Customer Facing Service instance with its commercial service specification catalog tier."@en ;
        rdfs:domain tmf:CustomerFacingService ;
        rdfs:range tmf:ServiceSpecification ;
        skos:altLabel "product tier specification"@en,
            "service catalog specification"@en .

    tmf:marketSegment a owl:DatatypeProperty ;
        rdfs:label "market segment"@en ;
        rdfs:comment "Commercial market classification tier such as enterprise VIP or public sector."@en ;
        rdfs:domain tmf:Customer ;
        rdfs:range xsd:string ;
        skos:altLabel "commercial segment"@en,
            "customer tier classification"@en .

    tmf:operationalStatus a owl:DatatypeProperty ;
        rdfs:label "operational status"@en ;
        rdfs:comment "Normalized lifecycle state of the connectivity service, such as ACTIVE or MAINTENANCE."@en ;
        rdfs:domain tmf:CustomerFacingService ;
        rdfs:range xsd:string ;
        skos:altLabel "canonical service state"@en,
            "circuit operational status"@en .

    tmf:partyLegalName a owl:DatatypeProperty ;
        rdfs:label "party legal name"@en ;
        rdfs:comment "Officially registered legal entity name of the enterprise customer."@en ;
        rdfs:domain tmf:Customer ;
        rdfs:range xsd:string ;
        skos:altLabel "corporate legal name"@en,
            "registered company name"@en .

    tmf:resourceId a owl:DatatypeProperty ;
        rdfs:label "resource identifier"@en ;
        rdfs:comment "Unique hardware inventory asset tag or management identifier."@en ;
        rdfs:domain tmf:PhysicalResource ;
        rdfs:range xsd:string ;
        skos:altLabel "device identifier"@en,
            "network element asset tag"@en .

    tmf:resourceName a owl:DatatypeProperty ;
        rdfs:label "resource name"@en ;
        rdfs:comment "DNS hostname or network management label for the physical hardware asset."@en ;
        rdfs:domain tmf:PhysicalResource ;
        rdfs:range xsd:string ;
        skos:altLabel "equipment hostname"@en,
            "system network label"@en .

    tmf:rfsId a owl:DatatypeProperty ;
        rdfs:label "resource facing service identifier"@en ;
        rdfs:comment "Internal system identifier for the underlying network transport bearer."@en ;
        rdfs:domain tmf:ResourceFacingService ;
        rdfs:range xsd:string ;
        skos:altLabel "RFS instance ID"@en,
            "bearer service identifier"@en .

    tmf:serviceId a owl:DatatypeProperty ;
        rdfs:label "service identifier"@en ;
        rdfs:comment "Unique telecom circuit reference code assigned to a customer-facing service."@en ;
        rdfs:domain tmf:CustomerFacingService ;
        rdfs:range xsd:string ;
        skos:altLabel "circuit identifier"@en,
            "service instance ID"@en .

    tmf:severity a owl:DatatypeProperty ;
        rdfs:label "severity"@en ;
        rdfs:comment "Impact severity classification of the assurance incident such as CRITICAL or MAJOR."@en ;
        rdfs:domain tmf:TroubleTicket ;
        rdfs:range xsd:string ;
        skos:altLabel "incident urgency"@en,
            "ticket severity level"@en .

    tmf:skuCode a owl:DatatypeProperty ;
        rdfs:label "SKU code"@en ;
        rdfs:comment "Commercial catalog product code identifying the service level tier."@en ;
        rdfs:domain tmf:ServiceSpecification ;
        rdfs:range xsd:string ;
        skos:altLabel "catalog product SKU"@en,
            "service tier code"@en .

    tmf:status a owl:DatatypeProperty ;
        rdfs:label "status"@en ;
        rdfs:comment "Operational resolution state of the trouble ticket such as OPEN, IN_PROGRESS, or RESOLVED."@en ;
        rdfs:domain tmf:TroubleTicket ;
        rdfs:range xsd:string ;
        skos:altLabel "incident workflow status"@en,
            "ticket resolution state"@en .

    tmf:supportsService a owl:ObjectProperty ;
        rdfs:label "supports service"@en ;
        rdfs:comment "Links an underlying Resource Facing Service transport bearer to the Customer Facing Service circuit it realizes."@en ;
        rdfs:domain tmf:ResourceFacingService ;
        rdfs:range tmf:CustomerFacingService ;
        skos:altLabel "realizes customer service"@en,
            "underlying transport bearer"@en .

    tmf:ticketId a owl:DatatypeProperty ;
        rdfs:label "ticket identifier"@en ;
        rdfs:comment "Unique reference number assigned to an operational trouble ticket."@en ;
        rdfs:domain tmf:TroubleTicket ;
        rdfs:range xsd:string ;
        skos:altLabel "incident number"@en,
            "trouble ticket reference"@en .

    <urn:telco:graph:tbox:sid-etom> a owl:Ontology ;
        rdfs:label "Enterprise L2 Fiber Assurance & Network Inventory Ontology"@en ;
        dcterms:identifier "PROP-UC-001-GATE1" ;
        rdfs:comment "Conceptual semantic model aligning Enterprise Layer 2 Carrier Ethernet customer service inventory, optical transport topology, and automated trouble triage with TM Forum SID GB922 and eTOM GB921 business processes."@en .

    telco:CpeDeviceResource a owl:Class ;
        rdfs:label "Customer Premises Equipment Resource"@en ;
        telco:alignedEtomProcess etom:Process_1_4_5_ResourceTroubleManagement ;
        rdfs:comment "Physical demarcation switch or router installed at the enterprise customer site."@en ;
        rdfs:subClassOf tmf:PhysicalResource ;
        skos:altLabel "CPE Device"@en,
            "Enterprise NTE Demarcation Chassis"@en,
            "On-Premises Optical Access Switch"@en .

    telco:PeRouterResource a owl:Class ;
        rdfs:label "Provider Edge Router Resource"@en ;
        telco:alignedEtomProcess etom:Process_1_4_5_ResourceTroubleManagement ;
        rdfs:comment "Metro or core Provider Edge router aggregating L2 Ethernet access bearers."@en ;
        rdfs:subClassOf tmf:PhysicalResource ;
        skos:altLabel "Edge Routing Node"@en,
            "Metro Aggregation Router"@en,
            "PE Router"@en .

    telco:SlaClause a owl:Class ;
        rdfs:label "Service Level Agreement Clause"@en ;
        telco:alignedEtomProcess etom:Process_1_3_7_ProblemHandling ;
        rdfs:comment "Contractual or catalog SLA clause specifying packet-loss thresholds, mean time to repair, service credit penalties, and VIP escalation rules."@en ;
        skos:altLabel "MSA Contractual Penalty Policy"@en,
            "Quality of Service Commitment"@en,
            "SLA Guarantee Clause"@en .

    telco:OltPortResource a owl:Class ;
        rdfs:label "OLT Optical Port Resource"@en ;
        telco:alignedEtomProcess etom:Process_1_4_5_ResourceTroubleManagement ;
        rdfs:comment "Optical Line Terminal transceiver port terminating the access fiber span and providing real-time gNMI DDM optical telemetry."@en ;
        rdfs:subClassOf tmf:PhysicalResource ;
        skos:altLabel "OLT Port"@en,
            "Optical Access Line Card Port"@en,
            "PON Optical Interface"@en .

    etom:BusinessProcess a owl:Class ;
        rdfs:label "Business Process"@en ;
        telco:alignedEtomProcess etom:Process_1_3_7_ProblemHandling,
            etom:Process_1_4_5_ResourceTroubleManagement ;
        rdfs:comment "An operational activity defined within the TM Forum eTOM business process framework governing service assurance and resource triage."@en ;
        skos:altLabel "Operational Workflow Task"@en,
            "Standard Operating Procedure"@en,
            "eTOM Process Definition"@en .

    tmf:PhysicalResourceSpec a owl:Class ;
        rdfs:label "Physical Resource Specification"@en ;
        telco:alignedEtomProcess etom:Process_1_4_5_ResourceTroubleManagement ;
        rdfs:comment "Vendor equipment model specification defining hardware capabilities, supported optical transceivers, and DDM calibration thresholds."@en ;
        skos:altLabel "Chassis Hardware Model"@en,
            "Hardware Model SKU"@en,
            "Vendor Equipment Specification"@en .

    telco:OpticalCalibrationProfile a owl:Class ;
        rdfs:label "Optical Calibration Profile"@en ;
        telco:alignedEtomProcess etom:Process_1_4_5_ResourceTroubleManagement ;
        rdfs:comment "Vendor hardware manual optical Digital Diagnostic Monitoring power envelope and autonomous laser bias recalibration specification."@en ;
        skos:altLabel "DDM Optical Power Envelope"@en,
            "Optical Attenuation Threshold Profile"@en,
            "SFP+ Tx/Rx Calibration Spec"@en .

    tmf:TroubleTicket a owl:Class ;
        rdfs:label "Trouble Ticket"@en ;
        telco:alignedEtomProcess etom:Process_1_3_7_ProblemHandling,
            etom:Process_1_4_5_ResourceTroubleManagement ;
        rdfs:comment "TMF621 operational assurance ticket tracking network incidents, automated remediations, or field fiber splicing dispatches."@en ;
        skos:altLabel "Field Dispatch Trouble Ticket"@en,
            "NOC Assurance Ticket"@en,
            "TMF621 Incident Record"@en .

    tmf:Customer a owl:Class ;
        rdfs:label "Customer"@en ;
        telco:alignedEtomProcess etom:Process_1_3_7_ProblemHandling ;
        rdfs:comment "An enterprise party or organization that subscribes to commercial telecom products and holds an active Master Service Agreement."@en ;
        skos:altLabel "B2B Account"@en,
            "Corporate Client"@en,
            "Enterprise Subscriber"@en .

    etom:Process_1_3_7_ProblemHandling a etom:BusinessProcess,
            owl:NamedIndividual ;
        rdfs:label "eTOM 1.3.7 Problem Handling"@en ;
        dcterms:identifier "1.3.7" ;
        rdfs:comment "Customer-facing service problem reception, SLA triage, root-cause correlation, and customer status notification."@en ;
        skos:altLabel "CFS SLA Assurance Triage"@en,
            "Customer Problem Handling"@en .

    tmf:PhysicalResource a owl:Class ;
        rdfs:label "Physical Resource"@en ;
        telco:alignedEtomProcess etom:Process_1_4_5_ResourceTroubleManagement ;
        rdfs:comment "A physical network equipment asset deployed in the provider core, access plant, or customer demarcation point."@en ;
        skos:altLabel "Network Inventory Element"@en,
            "Physical Hardware Asset"@en,
            "Telecom Network Device"@en .

    tmf:ResourceFacingService a owl:Class ;
        rdfs:label "Resource Facing Service"@en ;
        telco:alignedEtomProcess etom:Process_1_4_5_ResourceTroubleManagement ;
        rdfs:comment "Internal network transport and access bearer service realizing a CustomerFacingService across PE routers, OLT ports, fiber spans, and CPE devices."@en ;
        skos:altLabel "L2 Optical Bearer Service"@en,
            "Network Transport Bearer"@en,
            "RFS Access Bearer"@en .

    tmf:CustomerFacingService a owl:Class ;
        rdfs:label "Customer Facing Service"@en ;
        telco:alignedEtomProcess etom:Process_1_3_7_ProblemHandling ;
        rdfs:comment "An active Layer 2 Ethernet or wavelength connectivity circuit directly visible to and contracted by an enterprise customer."@en ;
        skos:altLabel "CFS Circuit"@en,
            "Carrier Ethernet Service"@en,
            "Enterprise L2 Fiber Circuit"@en .

    etom:Process_1_4_5_ResourceTroubleManagement a etom:BusinessProcess,
            owl:NamedIndividual ;
        rdfs:label "eTOM 1.4.5 Resource Trouble Management"@en ;
        dcterms:identifier "1.4.5" ;
        rdfs:comment "Network resource fault localization, optical transceiver DDM diagnostics, autonomous self-healing, and field technician dispatch."@en ;
        skos:altLabel "Network Fault Isolation & Remediation"@en,
            "Resource Trouble Management"@en .

    tmf:ServiceSpecification a owl:Class ;
        rdfs:label "Service Specification"@en ;
        telco:alignedEtomProcess etom:Process_1_3_7_ProblemHandling ;
        rdfs:comment "Standardized commercial catalog SKU defining bandwidth tier, SLA packet-loss ceiling, availability target, and autonomous remediation eligibility."@en ;
        skos:altLabel "Catalog Service Tier"@en,
            "Commercial Product SKU"@en,
            "SLA Service Specification"@en .
}

<urn:telco:graph:bites:doc-msa-v1> {
    <urn:telco:service:cfs:CIR-994821> a tmf:CustomerFacingService ;
        telco:bandwidthGbps 1e+01 ;
        tmf:serviceId "CIR-994821" .

    <urn:telco:spec:service:ETH-10G-GOLD> telco:autoRemediationAllowed true ;
        telco:hasSlaClause <urn:telco:sla:clause:CIR-994821-loss-recal> .

    <urn:telco:sla:clause:CIR-994821-loss-recal> a telco:SlaClause ;
        rdfs:label "CIR-994821 Bespoke SLA & Optical Recalibration Policy" ;
        telco:maxPacketLossPct 1e-01 .
}

<urn:telco:graph:bites:doc-hw-v4> {
    <urn:telco:spec:resource:CISCO-ASR-920-10G> a tmf:PhysicalResourceSpec ;
        telco:hasOpticalCalibrationProfile <urn:telco:spec:optical:CISCO-ASR-920-10G-profile> .

    <urn:telco:spec:resource:JUNIPER-ACX-10G> a tmf:PhysicalResourceSpec ;
        telco:hasOpticalCalibrationProfile <urn:telco:spec:optical:JUNIPER-ACX-10G-profile> .

    <urn:telco:spec:resource:NOK-7210-SAS-Mxp> a tmf:PhysicalResourceSpec ;
        telco:hasOpticalCalibrationProfile <urn:telco:spec:optical:NOK-7210-SAS-Mxp-profile> .

    <urn:telco:spec:optical:CISCO-ASR-920-10G-profile> a telco:OpticalCalibrationProfile ;
        telco:rxLosCutThresholdDbm -2.55e+01 ;
        telco:rxOpticalPowerMinDbm -2.3e+01 .

    <urn:telco:spec:optical:JUNIPER-ACX-10G-profile> a telco:OpticalCalibrationProfile ;
        telco:rxLosCutThresholdDbm -2.65e+01 ;
        telco:rxOpticalPowerMinDbm -2.4e+01 .

    <urn:telco:spec:optical:NOK-7210-SAS-Mxp-profile> a telco:OpticalCalibrationProfile ;
        rdfs:label "Nokia 7210 SAS-Mxp Optical DDM Calibration Profile" ;
        telco:rxLosCutThresholdDbm -2.75e+01 ;
        telco:rxOpticalPowerMinDbm -2.5e+01 .
}

<urn:telco:graph:ref:catalog> {
    <urn:telco:catalog:spec:5G-SLICE-EMBB> a tmf:ServiceSpecification ;
